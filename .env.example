NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=1

# JSON válido con los orígenes exactos del frontend, sin rutas ni slash final.
FRONTEND_ORIGINS=["http://localhost:5173","https://brisa-20-web.vercel.app"]

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brisa_rsvp
DB_USER=brisa_api
DB_PASSWORD=cambia-esta-contrasena
DB_USE_TLS=false
DB_CONNECTION_LIMIT=3
# Opcional. Para una CA en una variable, conserva los saltos como \n.
DB_SSL_CA=

# Usa una clave aleatoria de al menos 32 caracteres para proteger el panel.
ADMIN_API_KEY=cambia-por-una-clave-larga-y-aleatoria
